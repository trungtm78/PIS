{
  "schema": "clip-chapter/1",
  "id": "analytics",
  "title": "Báo cáo phân tích và BI",
  "summary": "Governance analytics: the KPI register with formula and source, the 19 contract analytics reports, EVM and the S curve, certified BI datasets, leader dashboards, the chart builder, exports and schedules.",
  "figures": {
    "ctr-count": {
      "kind": "count",
      "sample": 214,
      "description": "Contracts in the scope of the reader, from the portfolio total computed by the server.",
      "source": {
        "operation": "getContractPortfolio",
        "select": "totals.contract_count"
      }
    },
    "ctr-value": {
      "kind": "money-billion",
      "sample": 1286.4,
      "digits": 1,
      "description": "Sum of the contract prices in scope, in billions of dong, from the portfolio total.",
      "source": {
        "operation": "getContractPortfolio",
        "select": "totals.contract_value_billion"
      }
    },
    "price-gap-pct": {
      "kind": "percent",
      "sample": 3.8,
      "digits": 1,
      "description": "Average gap between the winning bid price and the contract price over the portfolio.",
      "source": {
        "operation": "getContractReport",
        "select": "rows[code=PRICE_GAP].summary.average_gap_pct"
      }
    }
  },
  "literalNumbers": {
    "19": "the plan fixes 19 contract analytics reports"
  },
  "animatics": {},
  "scenes": [
    {
      "id": "ana-hub",
      "chapter": "analytics",
      "main": true,
      "narration": "Trung tâm báo cáo hợp đồng gom 19 báo cáo phân tích. Bộ lọc và tổng cộng do máy chủ tính, nên số trên màn hình, trong Excel và trên điện thoại luôn khớp. Hiện có {{figure:ctr-count}} hợp đồng, giá trị {{figure:ctr-value}}.",
      "screen": {
        "platform": "web",
        "screens": [
          "CTR-28",
          "CTR-29"
        ]
      },
      "steps": [
        {
          "do": "as",
          "persona": "owner"
        },
        {
          "do": "open",
          "screen": "CTR-28"
        },
        {
          "do": "spot",
          "ref": "ctr.report-hub.cards"
        },
        {
          "do": "click",
          "ref": "ctr.report-hub.export-xlsx"
        }
      ],
      "captions": [
        {
          "text": "19 báo cáo · một định nghĩa số liệu",
          "atSec": 1.5,
          "forSec": 4
        }
      ],
      "expectedSec": 19.1
    },
    {
      "id": "ana-kpi-info",
      "chapter": "analytics",
      "main": true,
      "narration": "Mỗi con số có nút i: bấm vào để xem công thức, nguồn, giờ cập nhật và ngày chốt. Chỉ tiêu có một định nghĩa, một người chịu trách nhiệm.",
      "screen": {
        "platform": "web",
        "screens": [
          "BI-20",
          "BI-19"
        ]
      },
      "steps": [
        {
          "do": "as",
          "persona": "dgvSteward"
        },
        {
          "do": "open",
          "screen": "BI-20"
        },
        {
          "do": "click",
          "ref": "bi.kpi-register.info-button"
        },
        {
          "do": "spot",
          "ref": "bi.kpi-register.formula-panel"
        }
      ],
      "captions": [
        {
          "text": "Công thức · nguồn · giờ cập nhật · ngày chốt",
          "atSec": 2,
          "forSec": 5
        }
      ],
      "expectedSec": 10.5
    },
    {
      "id": "ana-evm",
      "chapter": "analytics",
      "main": true,
      "narration": "Báo cáo giá trị thu được tính đủ chỉ số chi phí và tiến độ, kèm đường S so với đường cơ sở. Chỉ khối lượng đã nghiệm thu mới tạo giá trị. Thiếu đường cơ sở thì ghi chưa đủ dữ liệu, không ghi số không.",
      "screen": {
        "platform": "web",
        "screens": [
          "PRJ-27",
          "PRJ-26"
        ]
      },
      "steps": [
        {
          "do": "as",
          "persona": "owner"
        },
        {
          "do": "open",
          "screen": "PRJ-27"
        },
        {
          "do": "spot",
          "ref": "prj.evm.s-curve"
        },
        {
          "do": "click",
          "ref": "prj.evm.view-at-date"
        }
