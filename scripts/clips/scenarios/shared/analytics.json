      "captions": [
        {
          "text": "Giá trị thu được chỉ từ khối lượng đã nghiệm thu",
          "atSec": 1.5,
          "forSec": 5
        }
      ],
      "expectedSec": 16,
      "onlyFor": [
        "public"
      ]
    },
    {
      "id": "ana-bi-dashboard",
      "chapter": "analytics",
      "main": true,
      "narration": "Dashboard lãnh đạo chỉ dùng chỉ tiêu đã chứng nhận. Người dùng tự dựng biểu đồ từ bộ dữ liệu phân quyền theo dòng và cột, rồi lưu, chia sẻ hoặc đặt lịch gửi.",
      "screen": {
        "platform": "web",
        "screens": [
          "BI-01",
          "BI-04"
        ]
      },
      "steps": [
        {
          "do": "as",
          "persona": "owner"
        },
        {
          "do": "open",
          "screen": "BI-01"
        },
        {
          "do": "click",
          "ref": "bi.dashboard.open-chart-builder"
        },
        {
          "do": "choose",
          "ref": "bi.chart-builder.dataset",
          "option": "first"
        },
        {
          "do": "click",
          "ref": "bi.chart-builder.save"
        }
      ],
      "captions": [
        {
          "text": "Chỉ tiêu đã chứng nhận · phân quyền dòng và cột",
          "atSec": 2,
          "forSec": 5
        }
      ],
      "expectedSec": 12.1
    },
    {
