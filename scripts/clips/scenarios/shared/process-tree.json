    {
      "id": "tree-phone",
      "chapter": "process-tree",
      "main": true,
      "narration": "Trên điện thoại, cây tiến độ là danh sách thụt vào, chạm một dòng để xem gói, chạm tiếp để xem tiến trình từng ngày. PWA của lãnh đạo hiện thành thẻ phễu.",
      "screen": {
        "platform": "phone",
