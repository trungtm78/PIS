    {
      "id": "tree-definition",
      "chapter": "process-tree",
      "main": false,
      "narration": "Quy trình lựa chọn nhà thầu là dữ liệu có phiên bản, cấu hình theo từng hình thức: đấu thầu rộng rãi, hạn chế, chỉ định thầu, chào hàng cạnh tranh và các hình thức khác. Mỗi bước có điều kiện vào, điều kiện ra, người chịu trách nhiệm, thời hạn chuẩn và bằng chứng. Các bước theo Luật Đấu thầu còn ghi chưa kiểm chứng.",
      "screen": {
        "platform": "web",
        "screens": [
          "BID-31"
        ]
      },
      "steps": [
        {
          "do": "as",
          "persona": "bidManager"
        },
        {
          "do": "open",
          "screen": "BID-31"
        },
        {
          "do": "choose",
          "ref": "bid.definition.method",
          "option": "first"
        },
        {
          "do": "spot",
          "ref": "bid.definition.step-list"
        }
      ],
      "captions": [
        {
          "text": "Con số pháp lý là cấu hình mặc định, chưa kiểm chứng",
          "atSec": 5,
          "forSec": 6
