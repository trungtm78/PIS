        {
          "do": "spot",
          "ref": "bid.tree.panel-overview"
        },
        {
          "do": "click",
          "ref": "bid.tree.panel-tab-packages"
        }
      ],
      "captions": [],
      "expectedSec": 10.2
    },
    {
