{
  "schema": "clip-chapter/1",
  "id": "process-tree",
  "title": "Cây tiến độ",
  "summary": "The progress tree of procurement packages: counts per state and flows between states, drill into a node and a package, the day by day timeline, the board by step, bottleneck analysis, the phone views, the process definition, checklists and alerts.",
  "figures": {
    "tree-packages-total": {
      "kind": "count",
      "sample": 38,
      "description": "All procurement packages in the scope of the reader, from the process tree.",
      "source": {
        "operation": "getPackageProcessTree",
        "select": "summary.total_packages"
      }
    },
    "tree-packages-late": {
      "kind": "count",
      "sample": 6,
      "description": "Packages whose current step is past its due day.",
      "source": {
        "operation": "getPackageProcessTree",
        "select": "summary.late_packages"
      }
    },
    "tree-median-days": {
      "kind": "days",
      "sample": 7,
      "description": "Median days a package stays in the busiest node.",
      "source": {
        "operation": "getPackageProcessTreeNode",
        "select": "node.median_days"
      }
    },
    "tree-stuck-days": {
      "kind": "days",
      "sample": 19,
      "description": "Days the longest stuck package has been in its step.",
      "source": {
        "operation": "getPackageWorkflowStatistics",
        "select": "bottlenecks[0].longest_days"
      }
    }
  },
  "literalNumbers": {},
  "animatics": {},
  "scenes": [
    {
      "id": "tree-overview",
      "chapter": "process-tree",
      "main": true,
      "narration": "Cây tiến độ cho thấy mọi gói thầu thành một cây trạng thái có số lượng. Mỗi nút ghi số gói, giá trị, ngày trung vị và số gói trễ, cạnh ghi số gói chuyển trong kỳ. Hiện có {{figure:tree-packages-total}} gói, {{figure:tree-packages-late}} gói trễ hạn.",
      "screen": {
        "platform": "web",
        "screens": [
          "BID-27"
        ]
      },
      "steps": [
        {
          "do": "as",
          "persona": "bidManager"
        },
        {
          "do": "open",
          "screen": "BID-27"
        },
        {
          "do": "spot",
          "ref": "bid.tree.canvas"
        },
        {
          "do": "point",
          "ref": "bid.tree.edge-label"
        }
      ],
      "captions": [
        {
          "text": "Cây tiến độ · số gói ở từng trạng thái",
          "atSec": 1.5,
          "forSec": 5
        }
      ],
      "expectedSec": 16
    },
    {
      "id": "tree-node",
      "chapter": "process-tree",
      "main": true,
      "narration": "Bấm vào một nút, bảng bên phải hiện ngày trung vị {{figure:tree-median-days}}, mục danh mục kiểm hay bỏ dở, người giữ nhiều gói và danh sách gói của nút.",
      "screen": {
        "platform": "web",
        "screens": [
          "BID-27"
        ]
      },
      "steps": [
        {
          "do": "click",
          "ref": "bid.tree.node-busiest"
