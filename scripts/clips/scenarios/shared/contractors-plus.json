    {
      "id": "vnd2-independence",
      "chapter": "contractors-plus",
      "main": false,
      "narration": "Trước khi chấm thầu, hệ thống kiểm tính độc lập giữa nhà thầu với hội đồng, cán bộ dự án và chủ đầu tư. Quan hệ họ hàng, cổ phần hay nơi làm việc cũ đều là căn cứ. Phát hiện mạnh chưa có người khác quyết định thì chặn bước trao thầu.",
      "screen": {
        "platform": "web",
        "screens": [
          "VND-07"
        ]
      },
      "steps": [
        {
          "do": "as",
          "persona": "bidManager"
        },
        {
          "do": "open",
          "screen": "VND-07"
        },
