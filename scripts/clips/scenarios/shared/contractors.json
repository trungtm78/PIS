  "scenes": [
    {
      "id": "vnd-registry",
      "chapter": "contractors",
      "main": true,
      "narration": "Mỗi nhà thầu có một hồ sơ chủ: kiểm mã số thuế, gợi ý hợp nhất hồ sơ trùng. Tài khoản nhận tiền cần hai người duyệt và gọi xác nhận lại. Tài khoản chưa hiệu lực thì chặn thanh toán.",
      "screen": {
        "platform": "web",
        "screens": [
          "BID-01",
          "BID-02",
          "VND-04"
        ]
      },
      "steps": [
        {
          "do": "as",
          "persona": "projectManager"
        },
        {
          "do": "open",
          "screen": "BID-01"
        },
        {
          "do": "click",
          "ref": "bid.contractors.first-row"
        },
        {
          "do": "spot",
          "ref": "bid.contractor.master-profile"
        },
        {
          "do": "open",
          "screen": "VND-04"
        },
        {
          "do": "spot",
          "ref": "vnd.bank-accounts.two-approvers"
        }
      ],
      "captions": [
        {
          "text": "Một hồ sơ chủ · tài khoản nhận tiền hai người duyệt",
          "atSec": 2,
          "forSec": 6
        }
      ],
      "expectedSec": 14.2
    },
    {
      "id": "vnd-restrictions",
      "chapter": "contractors",
      "main": true,
      "narration": "Hạn chế tham gia đấu thầu đi đủ thủ tục: đề nghị, thông báo, phản hồi, quyết định, hiệu lực. Có hiệu lực thì chặn cả liên danh ở khâu dự thầu, hợp đồng, thầu phụ và thanh toán.",
      "screen": {
        "platform": "web",
        "screens": [
          "BID-21"
        ]
      },
      "steps": [
        {
          "do": "as",
          "persona": "projectManager"
        },
        {
          "do": "open",
          "screen": "BID-21"
