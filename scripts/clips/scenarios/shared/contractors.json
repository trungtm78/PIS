          "as": "bidManager"
        }
      ],
      "captions": [],
      "expectedSec": 13.3
    },
    {
      "id": "vnd-scorecard",
      "chapter": "contractors",
      "main": true,
      "narration": "Bảng điểm chấm năm tiêu chí theo trọng số của quy tắc. Người chấm khác người duyệt. Vi phạm do một người ghi, người khác xác nhận, và hình phạt phải có văn bản quyết định.",
      "screen": {
        "platform": "web",
        "screens": [
          "CTR-23"
        ]
      },
      "steps": [
        {
          "do": "as",
          "persona": "projectManager"
        },
        {
          "do": "open",
          "screen": "CTR-23"
