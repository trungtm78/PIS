    },
    {
      "id": "ec-push-receipt",
      "chapter": "ent-cycle",
      "main": false,
      "narration": "Bước đẩy của luồng duyệt gọi HPM kèm khóa chống trùng, rồi chờ biên nhận. Còn chờ thì quyết định chưa hoàn tất. HPM từ chối thì báo cáo quay lại theo đường trả lại. Bộ ghi tệp chuẩn thay chỗ HPM, là giả định tạm, và biểu mẫu gửi đi là mẫu demo.",
      "screen": {
        "platform": "web",
        "screens": [
          "ADM-18",
          "HPM-01"
        ]
      },
      "steps": [
        {
          "do": "as",
