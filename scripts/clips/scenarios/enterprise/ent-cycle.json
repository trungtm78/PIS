    {
      "id": "ec-narrative",
      "chapter": "ent-cycle",
      "main": false,
      "narration": "Thuyết minh có cấu trúc tám mục. Đó là tình hình thực hiện, đánh giá mốc, đánh giá giải ngân, nguyên nhân, khó khăn, giải pháp, kế hoạch kỳ tới và kiến nghị. Kế thừa từ kỳ trước, nguyên nhân chọn từ danh mục chuẩn, và kết quả chỉ đạo giao ban tự điền vào.",
      "screen": {
        "platform": "web",
        "screens": [
          "DIS-35"
        ]
      },
      "steps": [
