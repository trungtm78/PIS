{
  "schema": "clip-chapter/1",
  "id": "ent-cycle",
  "title": "Chu kỳ báo cáo doanh nghiệp: chốt kỳ, thuyết minh, đẩy HPM",
  "summary": "The enterprise reporting cycle of ENT-3 and ENT-4: closing the enterprise period snapshot, the structured narrative of eight fields, the PUSH step that waits for the HPM receipt, the PVFCCo organisation pack, project codes and catalogues, cross-report comparison, PDF and layout configuration, the reporting calendar with reminders, the presentation mode and enterprise rates, equipment procurement, audit detail and catalogues. Every scene waits for its lane.",
  "mainOptional": true,
  "figures": {},
  "literalNumbers": {},
  "animatics": {},
  "typed": {},
  "scenes": [
    {
      "id": "ec-snapshot-close",
      "chapter": "ent-cycle",
      "main": false,
      "narration": "Lãnh đạo chốt kỳ: hệ thống dựng ảnh chụp số liệu doanh nghiệp từ kế hoạch vốn và chỉ tiêu đã nhập, rồi băm và đóng băng. Kỳ chưa đủ số của đơn vị nào thì không chốt được, và màn hình chỉ rõ đơn vị, dự án còn thiếu. Biểu mẫu, bảng điều hành và đẩy HPM đều đọc đúng một ảnh chụp ấy.",
      "screen": {
        "platform": "web",
        "screens": [
          "DIS-32",
          "DIS-27"
        ]
      },
      "steps": [
        {
          "do": "as",
          "persona": "capApprover"
        },
        {
          "do": "open",
          "screen": "DIS-32"
        },
        {
          "do": "spot",
          "ref": "dis.snapshot.build-close"
        },
