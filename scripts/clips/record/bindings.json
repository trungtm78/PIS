  "kinds": {
    "first-item": [
      "css:[data-screen-id] tbody tr a[href]",
      "css:[data-screen-id] tbody tr",
      "css:[data-screen-id] [role='row'] a[href]",
      "css:[data-screen-id] [role='listitem'] a[href]",
      "css:[data-screen-id] ul li a[href]",
      "css:[data-screen-id] ul li button",
      "css:[data-screen-id] article a[href]",
      "css:[data-screen-id] article button",
      "css:[data-screen-id] a[href]"
    ],
    "marker": [
      "css:[data-screen-id] [class*='marker' i]",
      "css:[data-screen-id] svg circle",
      "css:[data-screen-id] svg path[role='button']",
      "css:[data-screen-id] [class*=\"node\" i]",
      "css:[data-screen-id] svg g[role=\"button\"]"
    ],
    "table": [
      "css:[data-screen-id] table",
      "css:[data-screen-id] [role='table']",
      "css:[data-screen-id] [role='grid']"
    ],
    "list": [
      "css:[data-screen-id] ul",
      "css:[data-screen-id] [role='list']",
      "css:[data-screen-id] table"
    ],
    "chart": [
      "css:[data-screen-id] svg",
      "css:[data-screen-id] canvas",
      "css:[data-screen-id] [role='img']"
    ],
    "cards": [
      "css:[data-screen-id] [class*='grid' i]",
      "css:[data-screen-id] [class*='card' i]",
      "css:[data-screen-id] section"
    ],
    "form": [
      "css:[data-screen-id] form",
      "css:[data-screen-id] fieldset",
      "css:[data-screen-id] section"
    ],
    "region": [
      "css:[data-screen-id] section",
      "css:[data-screen-id] article",
      "css:[data-screen-id] > div > div",
      "css:[data-screen-id]"
    ],
    "select": [
      "role:combobox",
      "css:[data-screen-id] select"
    ]
  },
  "words": [
    {
      "match": "node|marker|pin",
      "kind": "marker",
      "verbs": [
        "click",
        "point"
      ]
    },
    {
      "match": "method|resolution|kind|filter|dataset|form|type|reason",
      "kind": "select",
      "verbs": [
        "choose"
      ]
    },
    {
      "match": "first-|row|item|record",
      "kind": "first-item",
      "verbs": [
        "click"
      ]
    },
    {
      "match": "table|rows|ranking|matrix|columns?|register|ledger|history|trail",
      "kind": "table"
    },
    {
      "match": "list|feed|checklist|warnings|findings|criteria",
      "kind": "list"
    },
    {
      "match": "curve|band|bar|map|canvas|timeline|chart|trend|forecast|s-curve|stepper|edge",
      "kind": "chart"
    },
    {
      "match": "grid|cards|strip|tiles|kpi|hub|board|panel",
      "kind": "cards"
    },
    {
      "match": "form|field|reason|input|preview|sheet",
      "kind": "form"
    }
  ],
  "loadingText": "đang tải|loading"
}
