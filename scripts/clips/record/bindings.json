{
  "schema": "clip-bindings/1",
  "note": "How the symbolic refs of the scenario steps (scripts/clips/refs.json) find a place on the real screen. Order of lookup: refs[<ref>], then tails.<verb>[<last segment of the ref>], then the kinds a word of the ref points to. A candidate is a target such as role:button:Luu|Ghi (the name is a case-insensitive pattern; a bar separates alternatives), label:, text:, testid:, placeholder:, css:. The first candidate that is visible on the screen wins. Add a line to refs when a screen needs an exact binding. Words are Vietnamese because the product screens are.",
  "refs": {
    "shell.alert-bell": [
      "css:[data-testid='alert-bell']",
      "role:button:Cảnh báo|Thông báo|Chuông",
      "css:header [aria-label*='ảnh báo' i]",
      "css:header [aria-label*='hông báo' i]"
    ],
    "home.rate-tiles.drill-link": [
      "css:[data-screen-id] [data-testid*='tile'] a[href]",
      "css:[data-screen-id] a[href*='drill' i]",
      "css:[data-screen-id] a[href]"
    ],
    "alerts.item.claim": [
      "role:button:Nhận|Tiếp nhận|Nhận xử lý"
    ],
    "alerts.item.snooze": [
      "role:button:Hoãn|Tạm hoãn"
    ],
    "alerts.snooze.reason": [
      "label:Lý do",
      "placeholder:Lý do",
      "css:[role='dialog'] textarea",
      "css:[role='dialog'] input[type='text']",
      "css:[data-screen-id] textarea"
    ],
    "pwa.install.button": [
      "css:[data-action='install']",
      "role:button:Cài đặt ứng dụng|Cài đặt"
    ],
    "pwa.approvals.queue": [
      "css:[data-screen-id='PWA-02'] ul",
      "css:[data-screen-id='PWA-02'] section",
      "css:[data-screen-id='PWA-02']"
    ],
    "pwa.dashboard.cards": [
      "css:[data-screen-id='PWA-03'] section",
      "css:[data-screen-id='PWA-03']"
    ],
    "pwa.directives.list": [
      "css:[data-screen-id='PWA-04'] ul",
      "css:[data-screen-id='PWA-04'] section",
      "css:[data-screen-id='PWA-04']"
    ],
    "ctr.scorecard.contractor": [
      "css:[data-screen-id] select[id*='pick-contractor']",
      "css:[data-screen-id] select"
    ],
    "ctr.scorecard.view": [
      "role:button:Xem bảng điểm"
    ],
    "ent.home.kpi-strip": [
      "css:[data-testid='leader-rates']",
      "css:[data-testid='leader-panel']"
    ],
    "ent.capital.structure-bar": [
      "css:[data-screen-id='HOME-07'] section:nth-of-type(2)",
      "css:[data-screen-id='HOME-07'] section"
    ]
  },
