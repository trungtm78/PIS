{
  "name": "machvon",
  "version": "0.0.0",
  "private": true,
  "description": "MACHVON platform monorepo (tenant-isolated kernel, database, contracts, API)",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . && npm run lint:error-codes && npm run commands:check && npm run i18n:check && npm run tokens:check && npm run routes:check -w @machvon/web && npm run migrations:check && npm run expand-contract:check && npm run infra:check && npm run alerts:check && npm run bi:metrics:check && npm run uat:check && npm run uat:screens:check && npm run cxn:check && npm run uat:evidence:check && npm run governance:check && npm run edition:check && npm run qa:check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present && node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include=scripts/architecture-check.mjs --test-coverage-include=scripts/coverage-libs.mjs --test-coverage-include=scripts/uat-run.mjs --test-coverage-include=scripts/lint-error-codes.mjs --test-coverage-include=scripts/contract-patch.mjs --test-coverage-include=scripts/command-coverage.mjs --test-coverage-include=scripts/i18n-lint.mjs --test-coverage-include=scripts/lane.mjs --test-coverage-include=scripts/migrations-check.mjs --test-coverage-include=scripts/sbom.mjs --test-coverage-include=scripts/supply-chain-check.mjs --test-coverage-include=scripts/infra-check.mjs --test-coverage-include=scripts/infra-bi-port.mjs --test-coverage-include=scripts/alerts-check.mjs --test-coverage-include=scripts/governance-check.mjs --test-coverage-include=scripts/expand-contract-check.mjs --test-coverage-include=scripts/deploy-gate.mjs --test-coverage-include=scripts/release.mjs --test-coverage-include=scripts/uat-trace.mjs --test-coverage-include=scripts/cxn-gate.mjs --test-coverage-include=scripts/uat-evidence.mjs --test-coverage-include=scripts/ai-eval/harness.mjs --test-coverage-include=scripts/ai-eval/mock-route.mjs --test-coverage-include=scripts/edition-check.mjs --test-coverage-include=scripts/edition-brand.mjs --test-coverage-include=scripts/perf-budget.mjs --test-coverage-include=scripts/uat-db-cases.mjs --test-coverage-include=scripts/a11y-lint.mjs --test-coverage-include=scripts/hdsd/verification.mjs --test-coverage-include=scripts/uat-screen-contract.mjs scripts/*.test.mjs scripts/clips/*.test.mjs",
    "architecture": "node scripts/architecture-check.mjs",
    "clips:check": "node scripts/clips/scenario.mjs check",
    "demo:enterprise": "node scripts/demo-enterprise.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "qa:check": "node scripts/a11y-lint.mjs && node scripts/hdsd/verification.mjs --check && node scripts/perf-budget.mjs --check && node scripts/clip-scripts-check.mjs && node scripts/hskt-trace.mjs check && node scripts/help-index.mjs check",
    "edition:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/edition-check.mjs",
    "coverage:libs": "node scripts/coverage-libs.mjs",
    "uat:run": "node scripts/uat-run.mjs",
    "contracts:generate": "npm run contracts:generate -w @machvon/contracts",
    "contracts:check": "npm run contracts:check -w @machvon/contracts",
    "contracts:compat": "npm run contracts:compat -w @machvon/contracts --",
    "db:generate": "npm run db:generate -w @machvon/db",
    "db:migrate": "npm run db:migrate -w @machvon/db",
    "db:check": "npm run db:check -w @machvon/db",
    "migrations:check": "node scripts/migrations-check.mjs",
    "sbom": "node scripts/sbom.mjs",
    "supply-chain:check": "node scripts/supply-chain-check.mjs",
    "infra:check": "node scripts/infra-check.mjs",
    "native-deps:check": "node scripts/native-deps-check.mjs",
    "backup:verify": "node scripts/backup-verify.mjs",
    "restore:drill": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/restore-drill.mjs",
    "restore:rehearse": "cd packages/db && node ../../scripts/lane.mjs db -- node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --testPathPatterns restore-drill-rehearsal --forceExit --coverage=false",
    "onprem:bundle": "node scripts/onprem-bundle.mjs",
    "alerts:check": "node scripts/alerts-check.mjs",
    "governance:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/governance-check.mjs",
    "bi:metrics:check": "node scripts/bi-metrics-bundle.mjs --check",
    "uat:trace": "node scripts/uat-trace.mjs",
    "uat:screens": "node scripts/uat-screen-contract.mjs generate",
    "uat:screens:check": "node scripts/uat-screen-contract.mjs check",
    "uat:check": "node scripts/uat-trace.mjs --check",
    "cxn:check": "node scripts/cxn-gate.mjs",
    "cxn:report": "node scripts/cxn-gate.mjs --report",
    "uat:db-cases": "node scripts/uat-db-cases.mjs",
    "uat:evidence": "node scripts/uat-evidence.mjs",
    "uat:evidence:check": "node scripts/uat-evidence.mjs --check",
    "uat:gate": "node scripts/uat-evidence.mjs --check --gate",
    "expand-contract:check": "node scripts/expand-contract-check.mjs",
    "jobs:run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/jobs-run.mjs",
    "test:lane": "node scripts/lane.mjs",
    "lint:error-codes": "node scripts/lint-error-codes.mjs",
    "commands:check": "node scripts/command-coverage.mjs",
    "i18n:check": "node scripts/i18n-lint.mjs",
    "tokens:generate": "npm run tokens:generate -w @machvon/design-tokens",
    "tokens:check": "npm run tokens:check -w @machvon/design-tokens",
    "contracts:mobile-pack": "npm run mobile-pack -w @machvon/contracts",
    "contracts:mobile-pack:check": "npm run mobile-pack:check -w @machvon/contracts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "fast-check": "4.10.2",
    "globals": "^17.0.0",
    "istanbul-lib-coverage": "3.2.2",
    "jest": "^30.0.0",
    "js-yaml": "4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "allowScripts": {
    "@swc/core": true,
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-x64@18.4.0-beta.17": true,
    "esbuild": false
  }
}
