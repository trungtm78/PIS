{
  "name": "@machvon/edition-enterprise",
  "version": "0.0.0",
  "private": true,
  "description": "Everything that belongs to the enterprise edition only (ENT-0): its manifest, its adapters and its report forms (RPT-1, src/server.ts). No public source imports it (npm run edition:check).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --coverage",
    "templates:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-demo-templates.mjs",
    "templates:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-demo-templates.mjs --check"
  },
  "jest": {
    "preset": "../../jest.preset.cjs",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/test/**/*.test.ts"
    ]
  },
  "dependencies": {
    "@machvon/kernel": "*",
    "docx": "9.15.3",
    "exceljs": "4.4.0",
    "fflate": "0.8.3"
  }
}
