{
  "name": "@machvon/db",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage --forceExit",
    "db:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli.ts generate --root ../..",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli.ts migrate --root ../..",
    "db:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli.ts check --root ../..",
    "restore:drill": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/restore-drill-cli.ts"
  },
  "dependencies": {
    "@machvon/kernel": "*",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
