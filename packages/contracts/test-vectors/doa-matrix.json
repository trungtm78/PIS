    }
  },
  "resolutions": [
    { "name": "one VND under the first threshold is the first band", "matrices": ["current", "previous"], "query": { "documentType": "FX", "amountVnd": "4999999999", "unitId": "department", "businessDate": "2026-03-01" }, "expected": { "matrixVersionId": "matrix-2", "ruleId": "r1", "ruleUnitId": "province", "approverRoleId": "LEADER_BQLGT", "approvalLevels": 1, "requiresDistinctApprovers": true } },
    { "name": "exactly the first threshold is the second band: a band includes its lower end and excludes its upper end", "matrices": ["current", "previous"], "query": { "documentType": "FX", "amountVnd": "5000000000", "unitId": "department", "businessDate": "2026-03-01" }, "expected": { "matrixVersionId": "matrix-2", "ruleId": "r2", "ruleUnitId": "province", "approverRoleId": "LEADER_STC", "approvalLevels": 1, "requiresDistinctApprovers": true } },
    { "name": "the last band has no upper end and needs two distinct approval levels", "matrices": ["current", "previous"], "query": { "documentType": "FX", "amountVnd": "25000000000", "unitId": "department", "businessDate": "2026-03-01" }, "expected": { "matrixVersionId": "matrix-2", "ruleId": "r3", "ruleUnitId": "province", "approverRoleId": "LEADER_UBND", "approvalLevels": 2, "requiresDistinctApprovers": true } },
    { "name": "one VND under the second threshold is still the second band", "matrices": ["current"], "query": { "documentType": "FX", "amountVnd": "24999999999", "unitId": "province", "businessDate": "2026-03-01" }, "expected": { "matrixVersionId": "matrix-2", "ruleId": "r2", "ruleUnitId": "province", "approverRoleId": "LEADER_STC", "approvalLevels": 1, "requiresDistinctApprovers": true } },
