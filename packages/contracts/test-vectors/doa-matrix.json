    { "name": "amounts beyond a double's exact range are compared exactly", "matrices": ["current"], "query": { "documentType": "FX", "amountVnd": "24999999999999999999", "unitId": "province", "businessDate": "2026-03-01" }, "expected": { "matrixVersionId": "matrix-2", "ruleId": "r3", "ruleUnitId": "province", "approverRoleId": "LEADER_UBND", "approvalLevels": 2, "requiresDistinctApprovers": true } },
    { "name": "the rule of the nearest unit wins over the rule of a unit above it", "matrices": ["current"], "query": { "documentType": "FX", "amountVnd": "30000000000", "unitId": "board", "businessDate": "2026-03-01" }, "expected": { "matrixVersionId": "matrix-2", "ruleId": "r4", "ruleUnitId": "board", "approverRoleId": "BOARD_HEAD", "approvalLevels": 1, "requiresDistinctApprovers": false } },
    { "name": "a rule without its subtree does not reach the units below, which fall back to the unit above", "matrices": ["current"], "query": { "documentType": "FX", "amountVnd": "30000000000", "unitId": "boardChild", "businessDate": "2026-03-01" }, "expected": { "matrixVersionId": "matrix-2", "ruleId": "r3", "ruleUnitId": "province", "approverRoleId": "LEADER_UBND", "approvalLevels": 2, "requiresDistinctApprovers": true } },
    { "name": "a rule with its subtree reaches a unit in another branch below the same unit", "matrices": ["current"], "query": { "documentType": "FX", "amountVnd": "1", "unitId": "elsewhere", "businessDate": "2026-03-01" }, "expected": { "matrixVersionId": "matrix-2", "ruleId": "r1", "ruleUnitId": "province", "approverRoleId": "LEADER_BQLGT", "approvalLevels": 1, "requiresDistinctApprovers": true } },
    { "name": "a rule that leaves the optional fields out means one level and distinct approvers", "matrices": ["current"], "query": { "documentType": "PAY", "amountVnd": "1000", "unitId": "board", "businessDate": "2026-03-01" }, "expected": { "matrixVersionId": "matrix-2", "ruleId": "r5", "ruleUnitId": "department", "approverRoleId": "DEPARTMENT_HEAD", "approvalLevels": 1, "requiresDistinctApprovers": true } },
    { "name": "the day before the new matrix begins is judged by the superseded one", "matrices": ["current", "previous"], "query": { "documentType": "FX", "amountVnd": "30000000000", "unitId": "department", "businessDate": "2025-12-31" }, "expected": { "matrixVersionId": "matrix-1", "ruleId": "o1", "ruleUnitId": "province", "approverRoleId": "LEADER_OLD", "approvalLevels": 1, "requiresDistinctApprovers": true } },
    { "name": "the first day of the new matrix is judged by the new one", "matrices": ["current", "previous"], "query": { "documentType": "FX", "amountVnd": "30000000000", "unitId": "department", "businessDate": "2026-01-01" }, "expected": { "matrixVersionId": "matrix-2", "ruleId": "r3", "ruleUnitId": "province", "approverRoleId": "LEADER_UBND", "approvalLevels": 2, "requiresDistinctApprovers": true } },
    { "name": "a draft never decides", "matrices": ["current", "draft"], "query": { "documentType": "FX", "amountVnd": "1", "unitId": "department", "businessDate": "2026-07-01" }, "expected": { "matrixVersionId": "matrix-2", "ruleId": "r1", "ruleUnitId": "province", "approverRoleId": "LEADER_BQLGT", "approvalLevels": 1, "requiresDistinctApprovers": true } }
  ],
