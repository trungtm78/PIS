        { "id": "r3", "document_type": "FX", "unit_id": "province", "include_subtree": true, "amount_min_vnd": "25000000000", "amount_max_vnd": null, "approver_role_id": "LEADER_UBND", "approval_levels": 2, "requires_distinct_approvers": true },
        { "id": "r4", "document_type": "FX", "unit_id": "board", "include_subtree": false, "amount_min_vnd": "0", "amount_max_vnd": null, "approver_role_id": "BOARD_HEAD", "approval_levels": 1, "requires_distinct_approvers": false },
        { "id": "r5", "document_type": "PAY", "unit_id": "department", "include_subtree": true, "amount_min_vnd": "0", "amount_max_vnd": null, "approver_role_id": "DEPARTMENT_HEAD" }
