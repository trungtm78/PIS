{
  "steps": [
    { "command": "add-error-code", "code": "PORTAL_INVITATION_STATE_INVALID", "status": 409, "en": "The portal invitation cannot make this move", "vi": "Lời mời vào cổng không chuyển được sang trạng thái này từ trạng thái hiện tại (PORTAL-2).", "module": "BID" },
    { "command": "add-error-code", "code": "PORTAL_INVITATION_EXISTS", "status": 409, "en": "A live invitation exists for this contact", "vi": "Nhà thầu đã có lời mời còn hiệu lực cho địa chỉ thư điện tử này (PORTAL-2).", "module": "BID" },
    { "command": "add-error-code", "code": "PORTAL_CONTACT_UNPROVEN", "status": 422, "en": "The contact is not proven to belong to the contractor", "vi": "Địa chỉ thư điện tử không trùng thư điện tử trong hồ sơ nhà thầu; hãy chọn căn cứ khác kèm số hiệu giấy tờ (PORTAL-2).", "module": "BID" },
    { "command": "add-error-code", "code": "CONTRACTOR_NOT_INVITABLE", "status": 422, "en": "The contractor cannot be invited to the portal", "vi": "Chỉ mời được nhà thầu có hồ sơ đã xác minh và không bị hạn chế (PORTAL-2).", "module": "BID" },
    { "command": "add-error-code", "code": "PORTAL_ACCESS_LIMIT", "status": 422, "en": "The contractor has the most portal accounts the rule allows", "vi": "Nhà thầu đã đủ số tài khoản cổng còn hiệu lực theo quy tắc VENDOR_PORTAL_ACCESS (PORTAL-2).", "module": "BID" },
    { "command": "add-error-code", "code": "PETITION_OUTCOME_STATE_INVALID", "status": 409, "en": "The petition outcome cannot make this move", "vi": "Kết quả giải quyết kiến nghị đã được xác nhận hoặc trả lại nên không đổi được nữa; hoặc kiến nghị đã có kết quả đang hiệu lực (PORTAL-2).", "module": "BID" },
    { "command": "add-error-code", "code": "PETITION_OUTCOME_NOT_ALLOWED", "status": 422, "en": "This outcome is not possible for the petition as it stands", "vi": "Kiến nghị ở trạng thái hiện tại chưa thể ghi kết quả này (được chấp nhận hoặc bác bỏ cần kiến nghị đã trả lời hoặc đã chuyển cấp trên) (PORTAL-2).", "module": "BID" },

    { "command": "add-schema", "name": "PortalInvitationNew", "schema": { "type": "object", "additionalProperties": false, "required": ["contractor_id", "contact_email", "contact_name", "contact_basis"], "properties": { "contractor_id": { "type": "string", "format": "uuid", "description": "The contractor of the registry; it must be verified and not restricted" }, "contact_email": { "type": "string", "minLength": 5, "maxLength": 254 }, "contact_name": { "type": "string", "minLength": 2, "maxLength": 200 }, "contact_basis": { "type": "string", "enum": ["REGISTRY_EMAIL", "REPRESENTATIVE_LETTER", "TAX_AUTHORITY_RECORD", "OTHER_EVIDENCE"], "description": "REGISTRY_EMAIL: the address equals the e-mail on the registry entry (checked by the server); the others name a paper in basis_reference" }, "basis_reference": { "type": "string", "minLength": 6, "maxLength": 300 } } } },
    { "command": "add-schema", "name": "PortalInvitationApprove", "schema": { "type": "object", "additionalProperties": false, "required": [], "properties": { "note": { "type": "string", "minLength": 5, "maxLength": 1000 } } } },
    { "command": "add-schema", "name": "PortalInvitationReason", "schema": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 5, "maxLength": 1000 } } } },
    { "command": "add-schema", "name": "PortalInvitationLine", "schema": { "type": "object", "additionalProperties": false, "required": ["id", "contractor_id", "contractor_name", "tax_identifier", "contact_email", "contact_name", "contact_basis", "status", "effective_status", "proposed_at", "proposal_expires_at", "actions", "version"], "properties": { "id": { "type": "string", "format": "uuid" }, "contractor_id": { "type": "string", "format": "uuid" }, "contractor_name": { "type": "string" }, "tax_identifier": { "type": "string" }, "contact_email": { "type": "string" }, "contact_name": { "type": "string" }, "contact_basis": { "type": "string", "enum": ["REGISTRY_EMAIL", "REPRESENTATIVE_LETTER", "TAX_AUTHORITY_RECORD", "OTHER_EVIDENCE"] }, "basis_reference": { "type": ["string", "null"] }, "status": { "type": "string", "enum": ["PROPOSED", "APPROVED", "REJECTED", "EXPIRED", "REVOKED"] }, "effective_status": { "type": "string", "enum": ["PROPOSED", "APPROVED", "REJECTED", "EXPIRED", "REVOKED"], "description": "The status as of now: a proposal or an access past its end reads EXPIRED before the nightly job writes it" }, "proposed_by_name": { "type": ["string", "null"] }, "proposed_at": { "type": "string", "format": "date-time" }, "proposal_expires_at": { "type": "string", "format": "date-time" }, "decided_by_name": { "type": ["string", "null"] }, "decided_at": { "type": ["string", "null"], "format": "date-time" }, "decision_note": { "type": ["string", "null"] }, "access_valid_until": { "type": ["string", "null"], "format": "date-time" }, "revoked_at": { "type": ["string", "null"], "format": "date-time" }, "revoke_reason": { "type": ["string", "null"] }, "actions": { "type": "object", "additionalProperties": false, "required": ["approve", "reject", "revoke"], "properties": { "approve": { "type": "boolean" }, "reject": { "type": "boolean" }, "revoke": { "type": "boolean" } } }, "version": { "type": "integer" } } } },
    { "command": "add-schema", "name": "PortalInvitationPage", "schema": { "type": "object", "additionalProperties": false, "required": ["items", "counts", "policy", "as_of"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/PortalInvitationLine" } }, "counts": { "type": "object", "additionalProperties": false, "required": ["proposed", "approved", "expired", "revoked"], "properties": { "proposed": { "type": "integer" }, "approved": { "type": "integer" }, "expired": { "type": "integer" }, "revoked": { "type": "integer" } } }, "policy": { "type": "object", "additionalProperties": false, "required": ["proposal_days", "access_days", "max_live_accounts", "max_upload_bytes", "version", "unverified"], "properties": { "proposal_days": { "type": "integer" }, "access_days": { "type": "integer" }, "max_live_accounts": { "type": "integer" }, "max_upload_bytes": { "type": "integer" }, "version": { "type": "string" }, "unverified": { "type": "boolean" } } }, "as_of": { "type": "string" } } } },

    { "command": "add-schema", "name": "BidPetitionOutcomeRecord", "schema": { "type": "object", "additionalProperties": false, "required": ["outcome", "decision_ref", "decision_on"], "properties": { "outcome": { "type": "string", "enum": ["UPHELD", "REJECTED", "WITHDRAWN"] }, "decision_ref": { "type": "string", "minLength": 3, "maxLength": 120, "description": "The number and the date of the decision of the authority, or the letter of withdrawal" }, "decision_on": { "type": "string", "format": "date" }, "decision_document_id": { "type": "string", "format": "uuid" }, "note": { "type": "string", "minLength": 1, "maxLength": 1000 } } } },
    { "command": "add-schema", "name": "BidPetitionOutcomeReturn", "schema": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 5, "maxLength": 1000 } } } },
    { "command": "add-schema", "name": "BidPetitionOutcomeLine", "schema": { "type": "object", "additionalProperties": false, "required": ["id", "petition_id", "package", "contractor", "outcome", "decision_ref", "decision_on", "status", "recorded_at", "actions", "version"], "properties": { "id": { "type": "string", "format": "uuid" }, "petition_id": { "type": "string", "format": "uuid" }, "package": { "type": "object", "additionalProperties": false, "required": ["id", "code"], "properties": { "id": { "type": "string", "format": "uuid" }, "code": { "type": "string" } } }, "contractor": { "type": "object", "additionalProperties": false, "required": ["id", "legal_name"], "properties": { "id": { "type": "string", "format": "uuid" }, "legal_name": { "type": "string" } } }, "petition_status": { "type": "string" }, "outcome": { "type": "string", "enum": ["UPHELD", "REJECTED", "WITHDRAWN"] }, "decision_ref": { "type": "string" }, "decision_on": { "type": "string", "format": "date" }, "decision_document_id": { "type": ["string", "null"], "format": "uuid" }, "note": { "type": ["string", "null"] }, "status": { "type": "string", "enum": ["PROPOSED", "CONFIRMED", "RETURNED"] }, "recorded_by_name": { "type": ["string", "null"] }, "recorded_at": { "type": "string", "format": "date-time" }, "checked_by_name": { "type": ["string", "null"] }, "checked_at": { "type": ["string", "null"], "format": "date-time" }, "return_reason": { "type": ["string", "null"] }, "actions": { "type": "object", "additionalProperties": false, "required": ["confirm", "return"], "properties": { "confirm": { "type": "boolean" }, "return": { "type": "boolean" } } }, "version": { "type": "integer" } } } },
    { "command": "add-schema", "name": "BidPetitionOutcomeList", "schema": { "type": "object", "additionalProperties": false, "required": ["items", "as_of"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/BidPetitionOutcomeLine" } }, "as_of": { "type": "string", "format": "date-time" } } } },

    { "command": "add-schema", "name": "PortalAttachment", "schema": { "type": "object", "additionalProperties": false, "required": ["id", "document_id", "purpose", "title", "mime", "size_bytes", "sha256", "uploaded_at"], "properties": { "id": { "type": "string", "format": "uuid" }, "document_id": { "type": "string", "format": "uuid", "description": "What the document_id fields of the portal commands take" }, "purpose": { "type": "string", "enum": ["REQUEST_RESPONSE", "CERTIFICATE", "REMEDIATION_EVIDENCE", "OTHER"] }, "title": { "type": "string" }, "mime": { "type": "string", "enum": ["application/pdf", "image/png", "image/jpeg"] }, "size_bytes": { "type": "integer" }, "sha256": { "type": "string" }, "uploaded_at": { "type": "string", "format": "date-time" }, "linked_kind": { "type": ["string", "null"], "enum": ["REQUEST", "QUALIFICATION", "REMEDIATION_ACTION", null] }, "linked_id": { "type": ["string", "null"], "format": "uuid" } } } },
    { "command": "add-schema", "name": "PortalAttachmentPage", "schema": { "type": "object", "additionalProperties": false, "required": ["items", "limits", "as_of"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/PortalAttachment" } }, "limits": { "type": "object", "additionalProperties": false, "required": ["max_bytes", "mimes"], "properties": { "max_bytes": { "type": "integer" }, "mimes": { "type": "array", "items": { "type": "string" } } } }, "as_of": { "type": "string" } } } },

    { "command": "add-schema", "replace": true, "name": "VendorDisputeStats", "schema": { "type": "object", "additionalProperties": false, "required": ["total", "open", "upheld", "rejected", "withdrawn", "awaiting_outcome", "upheld_pct", "mean_days_to_close"], "properties": { "total": { "type": "integer" }, "open": { "type": "integer" }, "upheld": { "type": "integer" }, "rejected": { "type": "integer" }, "withdrawn": { "type": "integer" }, "awaiting_outcome": { "type": "integer", "description": "Open petitions that were answered but have no confirmed decision yet; the share upheld is over decisions only" }, "upheld_pct": { "type": ["number", "null"] }, "mean_days_to_close": { "type": ["number", "null"] } } } },
    { "command": "add-schema", "replace": true, "name": "VendorDisputeLine", "schema": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "contractor_id", "contractor_name", "subject_code", "outcome", "source_status", "opened_on", "closed_on"], "properties": { "kind": { "type": "string", "enum": ["PETITION", "CLAIM"] }, "id": { "type": "string", "format": "uuid" }, "contractor_id": { "type": "string", "format": "uuid" }, "contractor_name": { "type": "string" }, "subject_code": { "type": ["string", "null"] }, "outcome": { "type": "string", "enum": ["OPEN", "UPHELD", "REJECTED", "WITHDRAWN"] }, "source_status": { "type": "string" }, "awaiting_outcome": { "type": "boolean" }, "decision_ref": { "type": ["string", "null"] }, "opened_on": { "type": "string", "format": "date" }, "closed_on": { "type": ["string", "null"], "format": "date" } } } },

    { "command": "add-operation", "path": "/vendor/portal/invitations", "method": "get", "build": { "operationId": "listVendorPortalInvitations", "summary": "Lời mời vào cổng của nhà thầu gắn với hồ sơ nhà thầu, không cần hợp đồng (VND-23)", "tags": ["VND"], "permission": "vnd.portal.manage", "responseRef": "PortalInvitationPage", "query": [{ "name": "status" }, { "name": "contractor_id", "format": "uuid" }] } },
    { "command": "add-operation", "path": "/vendor/portal/invitations", "method": "post", "build": { "operationId": "proposeVendorPortalInvitation", "summary": "Đề xuất mời một đầu mối của nhà thầu vào cổng, kèm căn cứ đầu mối thuộc nhà thầu; người khác phê duyệt (VND-23)", "tags": ["VND"], "permission": "vnd.portal.invite", "requestRef": "PortalInvitationNew", "errorCodes": ["VALIDATION_FAILED", "PORTAL_CONTACT_UNPROVEN", "CONTRACTOR_NOT_INVITABLE", "PORTAL_INVITATION_EXISTS", "PORTAL_ACCESS_LIMIT"], "domainEvents": ["vnd.portal.invitation.changed.v1"] } },
    { "command": "add-operation", "path": "/vendor/portal/invitations/{id}/approval", "method": "post", "build": { "operationId": "approveVendorPortalInvitation", "summary": "Phê duyệt lời mời vào cổng (người khác người đề xuất): tạo tài khoản khách gắn với nhà thầu và gửi lời mời (VND-23)", "tags": ["VND"], "permission": "vnd.portal.invite.approve", "requestRef": "PortalInvitationApprove", "errorCodes": ["VALIDATION_FAILED", "PORTAL_INVITATION_STATE_INVALID", "PORTAL_ACCESS_LIMIT", "CONTRACTOR_NOT_INVITABLE"], "domainEvents": ["vnd.portal.invitation.changed.v1", "iam.membership.invited.v1"], "ifMatch": true } },
    { "command": "add-operation", "path": "/vendor/portal/invitations/{id}/rejection", "method": "post", "build": { "operationId": "rejectVendorPortalInvitation", "summary": "Từ chối lời mời vào cổng kèm lý do (VND-23)", "tags": ["VND"], "permission": "vnd.portal.invite.approve", "requestRef": "PortalInvitationReason", "errorCodes": ["VALIDATION_FAILED", "PORTAL_INVITATION_STATE_INVALID"], "domainEvents": ["vnd.portal.invitation.changed.v1"], "ifMatch": true } },
    { "command": "add-operation", "path": "/vendor/portal/invitations/{id}/revocation", "method": "post", "build": { "operationId": "revokeVendorPortalInvitation", "summary": "Thu hồi lời mời hoặc quyền vào cổng ngay lập tức kèm lý do (VND-23)", "tags": ["VND"], "permission": "vnd.portal.invite.revoke", "requestRef": "PortalInvitationReason", "errorCodes": ["VALIDATION_FAILED", "PORTAL_INVITATION_STATE_INVALID"], "domainEvents": ["vnd.portal.invitation.changed.v1"], "ifMatch": true } },

    { "command": "add-operation", "path": "/procurement-petition-outcomes", "method": "get", "build": { "operationId": "listProcurementPetitionOutcomes", "summary": "Kết quả giải quyết kiến nghị của nhà thầu, kết quả chờ xác nhận trước (BID-34)", "tags": ["BID"], "permission": "bid.read", "responseRef": "BidPetitionOutcomeList", "query": [{ "name": "petition_id", "format": "uuid" }, { "name": "status" }] } },
    { "command": "add-operation", "path": "/procurement-petitions/{id}/outcome", "method": "post", "build": { "operationId": "recordProcurementPetitionOutcome", "summary": "Ghi kết quả giải quyết kiến nghị (chấp nhận, bác bỏ, rút) kèm số quyết định; người khác xác nhận (BID-34)", "tags": ["BID"], "permission": "bid.petition.outcome.record", "requestRef": "BidPetitionOutcomeRecord", "errorCodes": ["VALIDATION_FAILED", "PETITION_OUTCOME_NOT_ALLOWED", "PETITION_OUTCOME_STATE_INVALID", "CONFLICT_OF_INTEREST_BLOCKED"], "domainEvents": ["bid.petition.outcome.changed.v1"] } },
    { "command": "add-operation", "path": "/procurement-petition-outcomes/{id}/confirmation", "method": "post", "build": { "operationId": "confirmProcurementPetitionOutcome", "summary": "Xác nhận kết quả giải quyết kiến nghị (người khác người ghi); kết quả đã xác nhận vào số liệu tranh chấp (BID-34)", "tags": ["BID"], "permission": "bid.petition.outcome.confirm", "errorCodes": ["PETITION_OUTCOME_STATE_INVALID", "CONFLICT_OF_INTEREST_BLOCKED"], "domainEvents": ["bid.petition.outcome.changed.v1"], "ifMatch": true } },
    { "command": "add-operation", "path": "/procurement-petition-outcomes/{id}/return", "method": "post", "build": { "operationId": "returnProcurementPetitionOutcome", "summary": "Trả lại kết quả giải quyết kiến nghị kèm lý do để ghi lại (BID-34)", "tags": ["BID"], "permission": "bid.petition.outcome.confirm", "requestRef": "BidPetitionOutcomeReturn", "errorCodes": ["VALIDATION_FAILED", "PETITION_OUTCOME_STATE_INVALID"], "domainEvents": ["bid.petition.outcome.changed.v1"], "ifMatch": true } },

    { "command": "add-operation", "path": "/portal/attachments", "method": "get", "build": { "operationId": "listPortalAttachments", "summary": "Cổng nhà thầu: các tệp đã tải lên của chính nhà thầu và giới hạn tải (VND-24)", "tags": ["VND"], "permission": "vnd.portal.read", "responseRef": "PortalAttachmentPage", "query": [{ "name": "purpose" }] } },
    {
      "command": "add-operation",
      "path": "/portal/attachments",
      "method": "post",
      "operation": {
        "operationId": "uploadPortalAttachment",
        "summary": "Cổng nhà thầu: tải một tệp (PDF, PNG, JPEG) đính kèm; tệp được quét mã độc (mặc định từ chối khi chưa quét được) và ghi vào kho tài liệu (VND-24)",
        "tags": ["VND"],
        "x-permission": "vnd.portal.upload",
        "parameters": [
          { "name": "purpose", "in": "query", "required": true, "schema": { "type": "string", "enum": ["REQUEST_RESPONSE", "CERTIFICATE", "REMEDIATION_EVIDENCE", "OTHER"] } },
          { "name": "title", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 200 } },
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 16 } }
        ],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "additionalProperties": false, "properties": { "file": { "type": "string", "format": "binary" } }, "required": ["file"] } } } },
        "responses": {
          "200": { "description": "The file is stored, scanned clean and registered as a document of the contractor", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PortalAttachment" } } } },
          "400": { "description": "Invalid request", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "401": { "description": "Unauthenticated", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "403": { "description": "Forbidden", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "The file could not be scanned yet", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "413": { "description": "The file is larger than the limit of the rule", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "422": { "description": "Domain invariant failure", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "429": { "description": "Rate limit", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        },
        "x-error-codes": ["VALIDATION_FAILED", "FILE_NOT_CLEAN", "SCAN_PENDING", "PAYLOAD_TOO_LARGE", "FILE_TYPE_NOT_ALLOWED"],
        "x-idempotency": "required"
      }
    },

