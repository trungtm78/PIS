{
  "steps": [
    {
      "command": "add-schema",
      "name": "LeaderFundingStructure",
      "schema": {
        "type": "object",
        "required": [
          "measure",
          "plan_total_vnd",
          "disbursed_total_vnd",
          "classes"
        ],
        "properties": {
          "measure": {
            "type": "string"
          },
          "plan_total_vnd": {
            "type": [
              "string",
              "null"
            ]
          },
          "disbursed_total_vnd": {
            "type": [
              "string",
              "null"
            ]
          },
          "classes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "class_code",
                "plan_vnd",
                "disbursed_vnd",
                "plan_share_pct",
                "disbursed_share_pct",
                "rate_pct",
                "null_reason"
              ],
              "properties": {
                "class_code": {
                  "type": "string",
                  "description": "A class of the funding taxonomy of the enterprise pack (EQUITY, LOAN, OTHER)"
                },
                "plan_vnd": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Annual plan in force of the class, whole dong; null when no project has a plan in it"
                },
                "disbursed_vnd": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Disbursed since the start of the year, whole dong"
                },
                "plan_share_pct": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Share of the class in the plan in force, percent with four places"
                },
                "disbursed_share_pct": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Share of the class in the disbursed figure, percent with four places"
                },
                "rate_pct": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Disbursed over plan of the class, percent with four places"
                },
                "null_reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "command": "add-schema",
      "name": "LeaderRates",
      "schema": {
        "type": "object",
        "required": [
          "snapshot_id",
          "as_of_date",
          "company",
          "units",
          "projects",
          "as_of"
        ],
        "properties": {
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          },
          "as_of_date": {
            "type": "string",
            "format": "date"
          },
          "revision": {
            "type": "integer"
          },
          "snapshot_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "prior_snapshot_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "prior_as_of_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "definition_status": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "company": {
            "$ref": "#/components/schemas/LeaderRateRow"
          },
          "units": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeaderRateRow"
            }
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeaderRateRow"
            }
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "structure": {
            "$ref": "#/components/schemas/LeaderFundingStructure"
          }
        }
      },
      "replace": true
    }
  ]
}