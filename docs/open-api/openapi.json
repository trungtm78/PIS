                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 16
            },
            "description": "Optional: the exchange of credentials is repeatable by nature and keeps no stored answer, so a repeated request simply gets a new token"
          }
        ],
        "security": []
      }
    }
