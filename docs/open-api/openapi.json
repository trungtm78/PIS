    "/open/v1/token": {
      "post": {
        "operationId": "issueOpenApiToken",
        "summary": "Đổi mã khách và bí mật lấy mã truy cập ngắn hạn (client credentials) cho API mở",
        "tags": [
          "INT"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Client credentials are not valid",
            "content": {
              "application/problem+json": {
