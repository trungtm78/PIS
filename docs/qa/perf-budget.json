{
  "version": 1,
  "source": "Customer requirement: every function answers in under 5 seconds and every report in under 20 seconds, measured as the 95th percentile of the samples of one run.",
  "contract": "Design/MACHVON_Design/03_Engineering/openapi.json",
  "classes": {
    "FUNCTION": {
      "budgetMs": 5000,
      "description": "A hot read of a screen: lists, boards, counters and the home page."
    },
    "REPORT": {
      "budgetMs": 20000,
      "description": "A report or an export file, measured until the whole body is received."
    }
  },
  "defaults": {
    "samples": 20,
    "warmup": 2,
    "stat": "p95"
  },
  "variables": {
    "projectId": "id of a project of the measured tenant that has contracts and payments",
    "isoWeek": "ISO week such as 2026-W42",
    "reportDraftId": "id of a report draft that has an XLSX file",
    "reportIssueId": "id of an issued report that has a PDF file (the heaviest of its files, ENT-4b)",
    "reportExportId": "id of a finished report export",
    "mneReportId": "id of a monitoring and evaluation report",
    "evaluationReportId": "id of a bid evaluation report",
    "allocationLineId": "id of a line of the capital plan (the availability of a line is asked for one line)",
    "baselineProjectId": "id of a project that has a baseline version: the S-curve export draws from it, and a project without one answers 422 BASELINE_MISSING, so the first project of the list is not a sample",
    "enterpriseSnapshotId": "id of a frozen enterprise period snapshot (ENT-3a); a tenant of the public edition has none, so the rows that need it are skipped",
    "enterprisePeriodId": "id of the reporting period of that snapshot (the board of the calendar is read for one period)",
    "periodYear": "year of the enterprise period measured, such as 2026 (the calendar and the cross comparison are read for one year)",
    "periodMonth": "month, 1 to 12, of the enterprise period measured (the cross comparison of the reports of one month)"
  },
  "discovery": {
    "projectId": {"path": "/resources/project", "query": {"limit": "1"}, "pick": "items.0.id"},
    "allocationLineId": {"path": "/resources/allocation_line", "query": {"limit": "1"}, "pick": "items.0.id"},
    "baselineProjectId": {"path": "/resources/project", "query": {"limit": "100"}, "rows": "items", "pick": "id", "verify": {"path": "/projects/{value}/baseline", "pick": "has_baseline", "equals": true}, "scan": 100},
    "reportDraftId": {"path": "/report-engine/drafts", "query": {"limit": "1"}, "pick": "items.0.id"},
    "reportIssueId": {"path": "/report-engine/issues", "query": {"limit": "1"}, "pick": "items.0.id"},
    "enterpriseSnapshotId": {"path": "/enterprise-snapshots", "query": {"status": "FROZEN", "limit": "1"}, "pick": "items.0.id"},
    "enterprisePeriodId": {"path": "/enterprise-snapshots", "query": {"limit": "1", "status": "FROZEN"}, "pick": "items.0.period_id"}
  },
