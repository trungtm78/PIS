# Copy to compose/.env on the host and fill in. This file holds configuration only: every secret is a FILE under MACHVON_SECRETS_DIR
# (see infra/onprem/secrets.json for the list, who reads each and how to generate it). Nothing secret belongs in this file.

# The release being installed: the exact version printed by the offline bundle (never "latest").
MACHVON_VERSION=0.0.0
MACHVON_EDITION=public

# Public name of the installation (DNS name of the edge; the web image was built for it) and the host of the control plane.
PUBLIC_HOST=machvon.example.vn
CONTROL_HOST=control.machvon.example.vn
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# Directory that holds the secret files (owner root, group MACHVON_SECRETS_GID, directory 0750, files 0440).
MACHVON_SECRETS_DIR=/etc/machvon/secrets
# The group that may read them (files root:<gid>, mode 0440, directory 0750): every service joins it as a supplementary group.
MACHVON_SECRETS_GID=1900

# Identity: realm name and the first administrator of Keycloak (its password is the secret file keycloak_admin_password).
OIDC_REALM=machvon
KEYCLOAK_ADMIN_USER=machvon-admin
TENANT_TOKEN_KEY_ID=tenant-2026-1
LICENSE_SIGNING_KEY_ID=license-2026-1

# Directory federation (Active Directory over LDAPS). The bind password is the secret file ldap_bind_credential.
LDAP_URL=ldaps://ad.example.vn:636
LDAP_BIND_DN=CN=svc-machvon,OU=Service Accounts,DC=example,DC=vn
LDAP_USERS_DN=OU=Users,DC=example,DC=vn
LDAP_GROUPS_DN=OU=Groups,DC=example,DC=vn

# Backup repository: an S3 compatible bucket at the SECOND site with object lock (COMPLIANCE) enabled at creation. Keys are secret files.
BACKUP_S3_ENDPOINT=s3.second-site.example.vn
BACKUP_S3_BUCKET=machvon-backup
BACKUP_S3_REGION=vn-sgn-1

# Archive repository (repo2): the monthly full backup. A SEPARATE bucket with its own identity (a different object store account where the customer has one), object lock COMPLIANCE for 400 days. Keys and pass phrase are secret files.
BACKUP_ARCHIVE_S3_ENDPOINT=s3.archive-site.example.vn
BACKUP_ARCHIVE_S3_BUCKET=machvon-archive
BACKUP_ARCHIVE_S3_REGION=vn-sgn-1

# Sizing (limits per service; see docs/runbooks/infra/onprem-install.md for the reference sizes).
DB_SHARED_BUFFERS=2GB
DB_MAX_CONNECTIONS=200
DB_CPUS=4
DB_MEMORY=8g
KEYCLOAK_CPUS=2
KEYCLOAK_MEMORY=2g
CLAMAV_CPUS=2
CLAMAV_MEMORY=3g
API_CPUS=2
API_MEMORY=2g
API_MAX_BODY_BYTES=1048576
WORKERS_CPUS=2
WORKERS_MEMORY=2g
WEB_CPUS=1
WEB_MEMORY=256m
BACKUP_CPUS=2
BACKUP_MEMORY=2g

# Read-only port of the database for BI tools (Power BI gateway, Data Lakehouse): OPT-IN and CLOSED by default (INT-2, docs/runbooks/infra/bi-port.md). Switch on with
# `sh install.sh --with-bi` AFTER filling in every value below; the two secret files of secrets-bi.json (db_tls_cert, db_tls_key) are then required as well.
# off: nothing is published and compose.bi.yaml is not used. on: install.sh adds compose.bi.yaml, renders pg_hba.conf and refuses to start without the firewall chain.
MACHVON_BI=off
# The ONE address of this host the port listens on (an address of the internal network the BI tools reach; never 0.0.0.0 and never a public address). Empty = closed.
BI_LISTEN_ADDRESS=
BI_PORT=5433
# The source addresses that may connect, comma separated, each a CIDR (the Power BI data gateway, the Lakehouse ingest job): no 0.0.0.0/0. Empty = closed.
BI_ALLOWED_CIDRS=
# Connections one source address may hold open at once (the firewall limit; the limit of each login is set at INT-04).
BI_MAX_CONNECTIONS_PER_ADDRESS=20
# Where bi-render.sh writes pg_hba.conf on the host (not secret, root owned).
BI_CONFIG_DIR=/etc/machvon/bi
# Where the daily audit log files are shipped, and how long a shipped file stays on this host. The sink is mandatory when the port is on: directory:/path (a mount of the log store of the
# customer) or syslog:host:port (RFC 5424 over TCP). Empty = closed.
BI_AUDIT_SINK=
BI_AUDIT_RETENTION_DAYS=400
