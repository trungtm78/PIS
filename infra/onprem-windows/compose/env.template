# The environment file of the Windows-container deployment: host\install.ps1 writes it to C:\ProgramData\MACHVON\compose\.env from this template.
# Configuration only: every secret is a FILE under MACHVON_SECRETS_DIR\<service> (infra/onprem-windows/secrets.json). Nothing secret belongs in this file.

# The release that runs: written by host\install.ps1, host\update.ps1 and host\rollback.ps1 (never "latest").
MACHVON_VERSION=0.0.0
MACHVON_EDITION=public
# DEMONSTRATION mode with one factor: `true` lets people sign in with the password alone and takes that session as enough for the commands that ask for a second
# factor. It is accepted only together with MACHVON_DEPLOYMENT_PURPOSE=demo (the API refuses to start otherwise) and must stay `false` wherever real data lives.
# After a change run host\single-factor.ps1 (it restarts api and workers and switches the browser flow of the running realm).
MACHVON_DEMO_SINGLE_FACTOR=false
MACHVON_DEPLOYMENT_PURPOSE=
# DEMONSTRATION signing: `true` binds a stand-in of the certification authority (the product has no adapter of a real one yet), so that documents can be signed, sealed
# and issued at a demonstration. Accepted only together with MACHVON_DEPLOYMENT_PURPOSE=demo and the file secrets\api\demo_pki; switch it with host\demo-signing.ps1.
MACHVON_DEMO_SIGNING=false
# The Windows base image tag: it must match the build of the host (ltsc2025 on Windows Server 2025).
WINDOWS_TAG=ltsc2025

# The public address. PUBLIC_HOST is the host with its port as a browser and the mobile application name it (the web image was built for it);
# PUBLIC_HOSTNAME is the bare name; WEB_HTTPS_PORT the port of the host that is published (the only one).
PUBLIC_HOST=machvon.example.vn:8443
PUBLIC_HOSTNAME=machvon.example.vn
WEB_HTTPS_PORT=8443
# The control client of the realm sends the browser back to https://CONTROL_HOST/auth/callback (scripts/onprem-first-tenant.mjs reads the address that is pasted).
CONTROL_HOST=machvon.example.vn:8443

# The region tenants of this installation are placed in (vn-north or vn-south): host\control-plane.ps1 registers the one pool placement of this host under it,
# and the first tenant is requested for it.
MACHVON_REGION=vn-south

# Directory that holds the secret files, one sub-directory per service (Administrators and SYSTEM: full; ContainerUser: read).
MACHVON_SECRETS_DIR=C:\ProgramData\MACHVON\secrets

# The directory of the host the db container writes a dump to (Administrators and SYSTEM: full; ContainerUser: modify); host\backup.ps1 empties it.
MACHVON_BACKUP_SPOOL=C:\ProgramData\MACHVON\backup-spool

# Identity: realm name and the first administrator of Keycloak (its password is the secret file keycloak\keycloak_admin_password).
OIDC_REALM=machvon
KEYCLOAK_ADMIN_USER=machvon-admin
TENANT_TOKEN_KEY_ID=tenant-2026-1
LICENSE_SIGNING_KEY_ID=license-2026-1

# Directory federation (Active Directory over LDAPS). Without a directory these stay as they are and host\install.ps1 -DisableDirectory switches the
# federation provider off in the running realm; with one, fill them in, put its bind password in keycloak\ldap_bind_credential and enable the provider.
LDAP_URL=ldaps://directory.invalid:636
LDAP_BIND_DN=CN=svc-machvon,OU=Service Accounts,DC=example,DC=vn
LDAP_USERS_DN=OU=Users,DC=example,DC=vn
LDAP_GROUPS_DN=OU=Groups,DC=example,DC=vn

# Sizing (limits per service).
DB_SHARED_BUFFERS=1GB
DB_MAX_CONNECTIONS=200
DB_CPUS=4
DB_MEMORY=6g
KEYCLOAK_CPUS=2
KEYCLOAK_MEMORY=2g
# The heap of Keycloak, well below KEYCLOAK_MEMORY (the rest is metaspace, threads and buffers).
KEYCLOAK_JAVA_HEAP=-Xms512m -Xmx1280m
CLAMAV_CPUS=2
CLAMAV_MEMORY=3g
API_CPUS=2
API_MEMORY=2g
API_MAX_BODY_BYTES=1048576
WORKERS_CPUS=2
WORKERS_MEMORY=2g
WEB_CPUS=1
WEB_MEMORY=512m
